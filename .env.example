# Raster-converter address, not the OpenFreeMap upstream. Never commit real .env.
# OpenFreeMap itself requires no account, API key, or paid plan.
FR165_MAP_PROVIDER=openfreemap
FR165_PUBLIC_BASE_URL=https://your-private-test-host.example
FR165_DEV_TOKEN=generate-a-random-token-with-make-dev-config
# Watch tools auto-discover installed Garmin SDKs or use these explicit paths.
# CIQ_SDK_HOME=/path/to/connectiq-sdk
# CIQ_JAVA_HOME=/path/to/java/home
# CIQ_DEVELOPER_KEY=/private/path/developer.der
